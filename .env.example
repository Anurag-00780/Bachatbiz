# BachatBiz Environment Variables Example
# Copy to .env for custom configurations

# Port configuration (Defaults to 3000 in AI Studio Build)
PORT=3000

# GEMINI_API_KEY: Optional for Gemini AI Assistant integration
# If omitted or unset, BachatBiz automatically uses its comprehensive built-in local rule-based financial knowledge engine
GEMINI_API_KEY=""

# APP_URL: Base host URL of the application
APP_URL="http://localhost:3000"
